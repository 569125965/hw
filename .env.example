# 复制为 .env 后填写；.env 已在 .gitignore，切勿提交仓库
ASHARE_DEMO_MODE=0
ASHARE_CACHE_TTL=120

# OpenAI 兼容接口（DeepSeek / 通义 / OpenAI / 本地 vLLM 等）
LLM_PROVIDER=openai_compatible
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 也可使用 OPENAI_* 别名
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
